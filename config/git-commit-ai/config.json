{
  "model": "zenmux/google/gemma-4-31b-it",
  "providers": {
    "synthetic": {
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://api.synthetic.new/openai/v1",
      "env": ["SYNTHETIC_API_KEY"],
      "models": {
        "syn:small:text": {
          "name": "Synthetic Small Text",
          "reasoning": true
        }
      }
    },
    "streamlake": {
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://vanchin.streamlake.ai/api/gateway/coding/v1",
      "env": ["VC_API_KEY"],
      "models": {
        "ep-rwhav0-1784285728467953790": {
          "name": "KAT-Coder-Pro V2.5"
        }
      }
    },
    "mistral": {
      "extend": true,
      "models": {
        "devstral-small-latest": {
          "name": "devstral-small-latest"
        }
      }
    },
    "zenmux": {
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://zenmux.ai/api/v1",
      "env": ["ZENMUX_API_KEY"],
      "models": {
        "sapiens-ai/agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash"
        },
        "inclusionai/ling-3.0-tiny": {
          "name": "inclusionAI: Ling-3.0-tiny"
        }
      }
    }
  }
}
