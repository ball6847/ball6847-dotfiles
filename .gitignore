# Auto-update log files
auto-update.log

# Soul Mode - private workspace memory (do not commit)
.opencode/soul.md
.opencode/soul/

.opencode/todo.md
.opencode/archive
.opencode/plugins

.env

arms_cache

# Gitleaks local scan reports
gitleaks-report.*

# Rio per-OS deployed config (created by link-rio.sh)
config/rio/config.toml

# Python bytecode
__pycache__/
*.pyc

# Per-extension settings JSON written at runtime into ~/.pi/agent/extensions/
# (symlinked to pi/agent/extensions, e.g. synthetic.json)
pi/agent/extensions/*.json

# ...but committed placeholder templates stay tracked (no real endpoint in them).
!pi/agent/extensions/*.example.json

# The real Vast.ai config (live endpoint + API key) belongs at
# ~/.pi/agent/vastai-base-url.json, which is outside this repo entirely.
# Catch it anywhere it is mistakenly created inside the worktree.
# Basename-only, so it does not match *.example.json above.
vastai-base-url.json
